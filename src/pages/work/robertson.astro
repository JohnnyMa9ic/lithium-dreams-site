---
export const prerender = false;

/* Private, blinded proposal page prepared for Robertson Real Estate (Jay
 * Robertson). Reached only with the unguessable ?k= key below — an obscurity
 * soft-gate, appropriate for a client proposal (not credentials). noindex.
 * Standalone (no public Glasshouse nav) so the page reads as prepared-for-Jay,
 * but built on the Glasshouse design language so it is unmistakably the studio.
 * The AI Front Desk chatbot lower on the page is a MOCK — scripted, illustrative
 * responses, no live model — clearly labelled as a demonstration. */

const VIEW_KEY = 'a50808aaacc9d30e1b2bc01e01396b6a';
if (Astro.url.searchParams.get('k') !== VIEW_KEY) {
  return new Response('Not found', { status: 404 });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>A Growth Partnership — Prepared for Robertson Real Estate</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f5f3ee;
        --bg-warm: #efe9dd;
        --panel: #ffffff;
        --glass: rgba(255, 255, 255, 0.72);
        --text: #1a1d1a;
        --muted: #555a52;
        --faint: #8a8f88;
        --blue: #3d7fbd;
        --red: #9e2b2b;
        --red-bright: #b23636;
        --red-deep: #7f2222;
        --brass: #c99d4c;
        --brass-deep: #a67c2e;
        --walnut: #8b6547;
        --green: #7f9268;
        --green-soft: #9cad8d;
        --silver: #9ba8b2;
        --border: rgba(0, 0, 0, 0.10);
        --border-soft: rgba(0, 0, 0, 0.06);
        --shadow: 0 2px 20px rgba(40, 32, 20, 0.07);
        --shadow-lg: 0 10px 44px rgba(40, 32, 20, 0.12);
        --radius: 18px;
        --radius-sm: 12px;
        --max: 1080px;
        --sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
        --serif: 'Fraunces', ui-serif, Georgia, serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 1.02rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }

      /* Brand ribbon — frosted, floating over the hero image */
      .ribbon {
        position: absolute; top: 0; left: 0; right: 0; z-index: 6;
        display: flex; align-items: center; gap: 11px;
        padding: 16px clamp(20px, 4vw, 40px);
        background: rgba(20, 15, 10, 0.30);
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }
      .ribbon-mark {
        background: var(--red); color: #fff; font-family: var(--sans);
        font-size: .62rem; font-weight: 700; letter-spacing: .13em;
        padding: .42em .6em; line-height: 1; border-radius: 4px;
      }
      .ribbon-name { font-size: .76rem; font-weight: 500; letter-spacing: .03em; color: rgba(255,255,255,.9); }
      .ribbon-tag { margin-left: auto; font-size: .66rem; color: rgba(255,255,255,.62); letter-spacing: .14em; text-transform: uppercase; }

      /* Hero — the one cinematic moment: full-bleed image, Ken Burns, mobile-first */
      .hero {
        position: relative; width: 100%;
        height: 100vh; height: 100svh; min-height: 560px;
        overflow: hidden; background: #201811;
      }
      .hero-media {
        position: absolute; inset: 0; z-index: 0;
        background: url('/work/robertson-hero.jpg') center center / cover no-repeat;
        transform-origin: center; will-change: transform;
        animation: kenburns 7s ease-in-out infinite alternate;
      }
      @keyframes kenburns { from { transform: scale(1.0); } to { transform: scale(1.09); } }
      .hero-scrim {
        position: absolute; inset: 0; z-index: 1; pointer-events: none;
        background:
          linear-gradient(100deg, rgba(16,12,8,.82) 0%, rgba(16,12,8,.46) 40%, rgba(16,12,8,.08) 66%, transparent 82%),
          linear-gradient(0deg, rgba(16,12,8,.66) 0%, rgba(16,12,8,.10) 38%, transparent 55%);
      }
      .hero-inner {
        position: absolute; z-index: 5; left: 0; right: 0; bottom: 0;
        max-width: var(--max); margin: 0 auto;
        padding: 0 clamp(20px, 4vw, 40px) clamp(60px, 13vh, 128px);
      }
      .hero-eyebrow {
        display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
        color: #f0c9c0; font-size: clamp(.64rem, 1.6vw, .72rem); font-weight: 600;
        letter-spacing: .2em; text-transform: uppercase;
      }
      .hero-eyebrow::before { content: ''; width: 30px; height: 2px; background: var(--red-bright); display: inline-block; flex: none; }
      .hero h1 {
        font-family: var(--serif); font-weight: 400; color: #fff;
        font-size: clamp(2.15rem, 6.4vw, 5rem); line-height: 1.03; letter-spacing: -0.018em;
        max-width: 17ch; text-shadow: 0 2px 40px rgba(0,0,0,.42);
      }
      .hero h1 em { font-style: italic; font-weight: 500; color: #f4d9a6; }
      .hero-lede {
        margin-top: 22px; color: rgba(255,255,255,.92);
        font-size: clamp(1.02rem, 1.7vw, 1.35rem); line-height: 1.55; max-width: 46ch;
        text-shadow: 0 1px 18px rgba(0,0,0,.4);
      }
      .hero-meta {
        margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center;
        font-size: .8rem; color: rgba(255,255,255,.72); letter-spacing: .02em;
      }
      .hero-meta b { color: rgba(255,255,255,.94); font-weight: 600; }
      .hero-meta .dot { width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,.5); flex: none; }
      .scroll-cue {
        position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 6;
        color: rgba(255,255,255,.6); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase;
        display: flex; flex-direction: column; align-items: center; gap: 8px;
      }
      .scroll-cue .bar { width: 1px; height: 30px; background: linear-gradient(rgba(255,255,255,.65), transparent); animation: cue 2.4s ease-in-out infinite; }
      @keyframes cue { 0%, 100% { opacity: .25; transform: scaleY(.6); } 50% { opacity: 1; transform: scaleY(1); } }

      /* Sections */
      section { padding: 52px 0; }
      .sec-eyebrow {
        display: flex; align-items: center; gap: 11px;
        font-size: .7rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase;
        color: var(--red-deep); margin-bottom: 14px;
      }
      .sec-eyebrow::before { content: ''; width: 26px; height: 2px; background: var(--red); display: inline-block; flex: none; }
      h2 {
        font-family: var(--serif); font-weight: 500; font-size: clamp(1.7rem, 3.6vw, 2.4rem);
        line-height: 1.12; letter-spacing: -0.01em; margin-bottom: 20px;
      }
      h2 em { font-style: italic; font-weight: 500; color: var(--red); }
      h3 { font-size: 1.05rem; font-weight: 600; margin-bottom: 8px; letter-spacing: -0.005em; }
      p { margin-bottom: 16px; color: var(--text); }
      p.muted { color: var(--muted); }
      .lead-p { font-size: 1.12rem; color: var(--muted); }
      strong { font-weight: 600; }
      .divider { height: 1px; background: var(--border); border: 0; margin: 8px 0; }

      /* Note card */
      .note {
        background: #fffdf9; border: 1px solid var(--border);
        border-left: 3px solid var(--walnut); border-radius: var(--radius);
        padding: 30px 32px; box-shadow: var(--shadow);
      }
      .note p:last-child { margin-bottom: 0; }
      .signoff { font-family: var(--serif); font-style: italic; font-size: 1.18rem; color: var(--walnut); margin-top: 6px; }

      /* Summary panel */
      .summary {
        background: var(--bg-warm); border: 1px solid var(--border); border-top: 3px solid var(--red);
        border-radius: var(--radius); padding: 30px 32px;
      }
      .summary h2 { font-size: 1.5rem; margin-bottom: 14px; }

      /* Generic cards */
      .cards { display: grid; gap: 16px; }
      .cards.two { grid-template-columns: repeat(2, 1fr); }
      .cards.three { grid-template-columns: repeat(3, 1fr); }
      .card {
        background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm);
        padding: 20px 22px; box-shadow: var(--shadow); position: relative;
      }
      .card h3 { color: var(--text); }
      .card p { font-size: .95rem; color: var(--muted); margin-bottom: 0; }

      /* Foundation strip */
      .strengths { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 6px; }
      .strength {
        display: flex; gap: 12px; align-items: flex-start;
        padding: 14px 16px; background: var(--panel); border: 1px solid var(--border-soft);
        border-radius: var(--radius-sm);
      }
      .strength .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--green); margin-top: 7px; }
      .strength b { font-weight: 600; font-size: .95rem; }
      .strength span { display: block; font-size: .85rem; color: var(--muted); }

      /* Levers list */
      .levers { display: grid; gap: 12px; counter-reset: lever; }
      .lever {
        display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start;
        background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm);
        padding: 20px 22px; box-shadow: var(--shadow);
      }
      .lever-num {
        font-family: var(--serif); font-size: 1.5rem; color: var(--red); font-weight: 600;
        line-height: 1; min-width: 1.4ch;
      }
      .lever h3 { margin-bottom: 11px; }
      .lever .beat { font-size: .92rem; color: var(--text); margin-bottom: 9px; }
      .lever .beat:last-child { margin-bottom: 0; }
      .lever .beat b { font-weight: 600; }
      .lever .beat.opp b { color: var(--green); }
      .beat-label {
        display: inline-block; font-size: .58rem; font-weight: 700; letter-spacing: .09em;
        text-transform: uppercase; padding: 2px 8px; border-radius: 999px; margin-right: 9px;
        position: relative; top: -1px;
      }
      .beat-label.noticed { color: var(--muted); background: #eceae2; }
      .beat-label.leads { color: var(--red-deep); background: #f6e1de; }
      .beat-label.opp { color: #46592f; background: #e6ede0; }

      /* Spine (Capture/Convert/Compound) */
      .spine { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .stage {
        background: var(--panel); border: 1px solid var(--border); border-top: 3px solid var(--red);
        border-radius: var(--radius-sm); padding: 22px; box-shadow: var(--shadow);
      }
      .stage .label { font-family: var(--serif); font-size: 1.3rem; color: var(--text); margin-bottom: 8px; }
      .stage p { font-size: .92rem; color: var(--muted); margin-bottom: 10px; }
      .stage .plain { font-style: italic; color: var(--red-deep); font-size: .9rem; }

      /* Chatbot demo */
      .demo-frame {
        background: linear-gradient(160deg, #2a2b28 0%, #1d1e1b 100%);
        border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow-lg);
      }
      .demo-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
      .demo-head .t { color: #f2ede1; }
      .demo-head .t b { display: block; font-size: 1rem; }
      .demo-head .t span { font-size: .78rem; color: #a9a89f; }
      .demo-badge {
        margin-left: auto; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase;
        color: #d8cba8; border: 1px solid rgba(216,203,168,.4); border-radius: 999px; padding: 4px 10px;
      }
      .chat {
        background: #faf8f3; border-radius: 14px; overflow: hidden;
        display: flex; flex-direction: column; height: 460px; max-height: 70vh;
      }
      .chat-bar {
        display: flex; align-items: center; gap: 10px; padding: 12px 16px;
        background: #fff; border-bottom: 1px solid var(--border);
      }
      .chat-av {
        width: 34px; height: 34px; border-radius: 50%; flex: none;
        background: var(--red); color: #fff; display: grid; place-items: center;
        font-weight: 700; font-size: .8rem;
      }
      .chat-bar .who b { font-size: .88rem; display: block; line-height: 1.2; }
      .chat-bar .who span { font-size: .72rem; color: var(--green); }
      .chat-bar .who span::before { content: '● '; }
      .chat-log { flex: 1; overflow-y: auto; padding: 18px 16px; display: flex; flex-direction: column; gap: 10px; }
      .msg { max-width: 80%; padding: 10px 14px; border-radius: 14px; font-size: .92rem; line-height: 1.5; }
      .msg.bot { align-self: flex-start; background: #eef0ea; color: var(--text); border-bottom-left-radius: 4px; }
      .msg.user { align-self: flex-end; background: var(--red); color: #fff; border-bottom-right-radius: 4px; }
      .typing { align-self: flex-start; background: #eef0ea; border-radius: 14px; padding: 12px 16px; display: inline-flex; gap: 4px; }
      .typing i { width: 7px; height: 7px; border-radius: 50%; background: #9aa093; animation: blink 1.2s infinite; }
      .typing i:nth-child(2) { animation-delay: .2s; }
      .typing i:nth-child(3) { animation-delay: .4s; }
      @keyframes blink { 0%, 60%, 100% { opacity: .25; } 30% { opacity: 1; } }
      .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 16px 4px; }
      .chip {
        font-family: var(--sans); font-size: .8rem; color: var(--red); background: #fff;
        border: 1px solid var(--red); border-radius: 999px; padding: 6px 12px; cursor: pointer;
        transition: all .15s ease;
      }
      .chip:hover { background: var(--red); color: #fff; }
      .chat-input { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--border); background: #fff; }
      .chat-input input {
        flex: 1; border: 1px solid var(--border); border-radius: 999px; padding: 10px 16px;
        font-family: var(--sans); font-size: .9rem; outline: none;
      }
      .chat-input input:focus { border-color: var(--red); }
      .chat-input button {
        border: 0; background: var(--red); color: #fff; border-radius: 999px;
        padding: 0 18px; font-family: var(--sans); font-weight: 600; font-size: .88rem; cursor: pointer;
      }
      .chat-input button:hover { background: var(--red-deep); }
      .demo-caption { color: #b8b6ac; font-size: .8rem; margin-top: 16px; text-align: center; }

      /* Module list */
      .modules { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .module {
        background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm);
        padding: 20px 22px; box-shadow: var(--shadow);
      }
      .module.star { border-color: var(--red); border-width: 1.5px; background: linear-gradient(180deg,#fdf5f4,#fff); }
      .module .mtitle { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; }
      .module .mtitle b { font-size: 1rem; font-weight: 600; }
      .module .starmark { flex: none; white-space: nowrap; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: var(--red-deep); border: 1px solid var(--red); border-radius: 999px; padding: 2px 8px; }
      .module p { font-size: .92rem; color: var(--muted); margin-bottom: 0; }

      /* Highlight (farm & land) */
      .highlight {
        background: linear-gradient(150deg, #3a4232 0%, #2b3126 100%);
        color: #eef0e6; border-radius: var(--radius); padding: 40px 36px; box-shadow: var(--shadow-lg);
      }
      .highlight .sec-eyebrow { color: #e7d7a8; }
      .highlight .sec-eyebrow::before { background: var(--red-bright); }
      .highlight h2 { color: #fff; }
      .highlight h2 em { font-style: italic; font-weight: 500; color: #dd7a6f; }
      .highlight p { color: #d3d8c8; }
      .highlight p:last-child { margin-bottom: 0; }
      .highlight .subhead { color: #fff; font-weight: 600; font-size: 1.06rem; margin: 30px 0 8px; }
      .highlight .rule { height: 1px; background: rgba(255,255,255,0.14); margin: 30px 0 0; border: 0; }

      /* Phases */
      .phases { display: grid; gap: 12px; }
      .phase {
        display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: start;
        background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm);
        padding: 22px 24px; box-shadow: var(--shadow);
      }
      .phase .pn { font-family: var(--serif); font-size: 1.4rem; color: var(--red); font-weight: 600; min-width: 1.4ch; }
      .phase .why { font-size: .88rem; color: var(--faint); margin-top: 6px; margin-bottom: 0; }
      .partner {
        margin-top: 16px; background: var(--bg-warm); border: 1px solid var(--border);
        border-left: 3px solid var(--green); border-radius: var(--radius-sm); padding: 22px 24px;
      }
      .partner p:last-child { margin-bottom: 0; }

      /* Investment */
      .pilot {
        background: linear-gradient(150deg,#fdf5f4,#fff); border: 1.5px solid var(--red);
        border-radius: var(--radius); padding: 26px 28px; box-shadow: var(--shadow); margin-bottom: 18px;
      }
      .pilot .tag { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--red-deep); font-weight: 600; }
      .pilot h3 { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; margin: 8px 0 10px; }
      .pilot .nums { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 10px; }
      .pilot .nums div span { display: block; font-size: .74rem; color: var(--faint); text-transform: uppercase; letter-spacing: .08em; }
      .pilot .nums div b { font-size: 1.15rem; font-weight: 600; }
      .tiers { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 18px; }
      .tier {
        background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm);
        padding: 22px; box-shadow: var(--shadow); display: flex; flex-direction: column;
      }
      .tier.rec { border-color: var(--green); border-width: 1.5px; }
      .tier .rec-badge { align-self: flex-start; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: #fff; background: var(--green); border-radius: 999px; padding: 3px 9px; margin-bottom: 10px; }
      .tier .tname { font-weight: 600; font-size: 1.05rem; }
      .tier .price { font-family: var(--serif); font-size: 1.7rem; color: var(--text); margin: 4px 0 12px; }
      .tier .price small { font-family: var(--sans); font-size: .8rem; color: var(--faint); font-weight: 400; }
      .tier p { font-size: .88rem; color: var(--muted); margin-bottom: 0; }
      .bundle {
        background: var(--bg-warm); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 26px 28px;
      }
      .bundle .price { font-family: var(--serif); font-size: 1.9rem; color: var(--red-deep); }
      .compare { font-size: .86rem; color: var(--faint); font-style: italic; margin-top: 14px; }
      .vcompare { margin-top: 30px; }
      .vcompare > h3 { margin-bottom: 8px; }
      .vwrap { margin-top: 16px; overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow); }
      .vtable { width: 100%; border-collapse: collapse; font-size: .9rem; min-width: 580px; background: var(--panel); }
      .vtable th, .vtable td { text-align: left; padding: 13px 15px; vertical-align: top; border-bottom: 1px solid var(--border-soft); }
      .vtable thead th { font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); font-weight: 700; background: var(--bg-warm); }
      .vtable tbody tr:last-child td { border-bottom: none; }
      .vtable td.want { font-weight: 600; color: var(--text); width: 26%; }
      .vtable td.usual { color: var(--muted); width: 37%; }
      .vtable td.usual b { color: var(--text); font-weight: 600; }
      .vtable td.mine { color: var(--text); width: 37%; background: rgba(127, 146, 104, 0.07); }
      .vtable td.mine b { color: var(--green); font-weight: 600; }
      .assurances { margin-top: 30px; padding: 26px 28px; background: var(--bg-warm); border-radius: var(--radius); }
      .assurances > h3 { margin-bottom: 16px; }
      .asrow { display: flex; gap: 12px; margin-bottom: 13px; font-size: .93rem; color: var(--muted); }
      .asrow:last-child { margin-bottom: 0; }
      .asrow b { color: var(--text); font-weight: 600; }
      .ascheck { flex: none; width: 21px; height: 21px; border-radius: 50%; background: var(--green); color: #fff; font-size: .7rem; line-height: 21px; text-align: center; margin-top: 1px; }

      /* Close */
      .close-block { background: var(--glass); border: 1px solid var(--border); border-radius: var(--radius); padding: 34px 34px; box-shadow: var(--shadow); }
      .close-block h2 { margin-bottom: 16px; }

      footer { padding: 40px 0 64px; border-top: 1px solid var(--border); margin-top: 40px; }
      .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; font-size: .8rem; color: var(--faint); }
      .foot b { color: var(--muted); font-weight: 600; }

      @media (max-width: 720px) {
        .cards.two, .cards.three, .strengths, .spine, .modules, .tiers { grid-template-columns: 1fr; }
        .lever, .phase { grid-template-columns: 1fr; gap: 6px; }
        .lever-num, .phase .pn { font-size: 1.1rem; }
        .ribbon-tag { display: none; }
        /* On a narrow screen, weight the scrim to the bottom so the headline
           stays readable over whatever part of the photo sits behind it. */
        .hero-scrim {
          background:
            linear-gradient(0deg, rgba(16,12,8,.84) 0%, rgba(16,12,8,.36) 46%, rgba(16,12,8,.06) 72%, transparent 90%),
            linear-gradient(100deg, rgba(16,12,8,.40) 0%, transparent 62%);
        }
        .hero-inner { padding-bottom: clamp(52px, 12vh, 92px); }
