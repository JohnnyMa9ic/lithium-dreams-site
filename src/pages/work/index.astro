---
import GlasshouseLayout from '../../components/GlasshouseLayout.astro';
---

<GlasshouseLayout activePage="/work">

  <!-- Hero — the conservatory at dusk -->
  <section class="stratum hero">
    <div class="hero-inner">
      <img src="/gh-medallion-256.png" alt="" width="84" height="84" class="hero-mark" fetchpriority="high" />
      <p class="gh-eyebrow hero-eyebrow">Glasshouse Systems Studio</p>
      <h1 class="hero-headline">You run the business. The&nbsp;systems should run themselves.</h1>
      <p class="hero-offer">Systems and automation for people who'd rather run their business than wrestle their tools.</p>
      <div class="hero-actions">
        <a href="/work/intake" class="btn-plaque">Start your brief</a>
        <a href="#method" class="btn-ghost">See how we work</a>
      </div>
      <p class="hero-avail">Taking new projects — fall 2026.</p>
    </div>
  </section>

  <!-- Commissioned works — the problems, as museum plaques -->
  <section class="stratum stratum--cream sec" id="commissions" aria-labelledby="commissions-h">
    <header class="sec-head">
      <p class="gh-eyebrow">Commissioned Works</p>
      <h2 class="sec-headline" id="commissions-h">The problems we take off your plate.</h2>
      <div class="gh-rule sec-rule" aria-hidden="true"><span></span></div>
    </header>
    <div class="plaques">
      <article class="plaque">
        <img src="/gh-roundel-automation.svg" alt="" width="56" height="56" class="plaque-roundel" loading="lazy" />
        <h3>Leads slip through the cracks.</h3>
        <p>Lead capture, response workflows, qualification, scheduling, and follow-up. AI where it earns its place — not everywhere.</p>
        <div class="plaque-tag">Automation Systems</div>
      </article>
      <article class="plaque">
        <img src="/gh-roundel-dashboard.svg" alt="" width="56" height="56" class="plaque-roundel" loading="lazy" />
        <h3>You're the bottleneck for everything.</h3>
        <p>Inbox, calendar, meeting prep, and metrics for the solo operator. Systems built around how you actually work.</p>
        <div class="plaque-tag">Operator Dashboards</div>
      </article>
      <article class="plaque">
        <img src="/gh-roundel-knowledge.svg" alt="" width="56" height="56" class="plaque-roundel" loading="lazy" />
        <h3>You can never find what you already know.</h3>
        <p>Ongoing monitoring, synthesis, and brief generation. Second brains, documentation, institutional memory, and search that works.</p>
        <div class="plaque-tag">Knowledge Systems</div>
      </article>
      <article class="plaque">
        <img src="/gh-roundel-creative.svg" alt="" width="56" height="56" class="plaque-roundel" loading="lazy" />
        <h3>Publishing eats your week.</h3>
        <p>Brand knowledge infrastructure, content pipelines, and long-form to short-form repurposing. Less manual assembly, more signal.</p>
        <div class="plaque-tag">Creative Systems</div>
      </article>
    </div>
  </section>

  <!-- The method — materials cabinet, four stages fused with four materials -->
  <section class="stratum stratum--dark sec" id="method" aria-labelledby="method-h">
    <header class="sec-head">
      <p class="gh-eyebrow">The Method</p>
      <h2 class="sec-headline sec-headline--display" id="method-h">Four stages. No&nbsp;shortcuts.</h2>
      <div class="gh-rule sec-rule" aria-hidden="true"><span></span></div>
      <p class="sec-sub">Four materials in the studio's cabinet — each one a stage of the work.</p>
    </header>
    <div class="plates">
      <figure class="plate">
        <div class="plate-texture plate-texture--walnut" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">01 · Understand</div>
          <div class="plate-material">Walnut — Human Understanding</div>
          <p>Every business already has an operating system. It lives in spreadsheets, in one person's head, or as habit. We map how your work actually flows before touching any tools.</p>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="plate-texture plate-texture--iron" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">02 · Design</div>
          <div class="plate-material">Oxidized Iron — System Structure</div>
          <p>We improve it, document it, and map the gaps. Structure before tools. Clarity before complexity. The design phase is where most of the value lives.</p>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="plate-texture plate-texture--glass" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">03 · Build</div>
          <div class="plate-material">Frosted Glass — Operational Clarity</div>
          <p>Then we build the infrastructure that lets it scale — and you can see through all of it. Dashboards, outputs, and documentation that show exactly what's working.</p>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="plate-texture plate-texture--green" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">04 · Operate</div>
          <div class="plate-material">Living Green — Sustainable Adoption</div>
          <p>Clean handoff with full documentation, then ongoing support. Systems only work if people use them. We stay until it runs without us — and check in to make sure it still does.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Proof — the studio runs on its own systems -->
  <section class="stratum stratum--cream sec" id="proof" aria-labelledby="proof-h">
    <header class="sec-head">
      <p class="gh-eyebrow">Proof</p>
      <h2 class="sec-headline" id="proof-h">Every system we sell, we run first.</h2>
      <div class="gh-rule sec-rule" aria-hidden="true"><span></span></div>
    </header>
    <ul class="proof-ledger">
      <li>The research and monitoring stack that briefs the studio every morning — the same knowledge systems we build for clients.</li>
      <li>The content pipeline behind the studio's own channel and this site — the creative systems track, running in production.</li>
      <li>The project brief on this site fed our first client engagement end to end — a structured brief in, a finished proposal out, for a real-estate office in eastern Iowa.</li>
    </ul>
    <p class="proof-note">If a system doesn't survive contact with real operations, we don't sell it.</p>
  </section>

  <!-- The operator + close -->
  <section class="stratum stratum--cream sec sec--operator" id="operator" aria-labelledby="operator-h">
    <div class="gh-rule operator-rule" aria-hidden="true"><span></span></div>
    <div class="operator-grid">
      <div class="operator-copy">
        <p class="gh-eyebrow">The Operator</p>
        <h2 class="sec-headline" id="operator-h">Built by an operator, not an AI&nbsp;tourist.</h2>
        <p>Glasshouse Systems Studio is a systems design practice. AI is one of our tools — not our product and not our identity. We design practical operational systems for people who need clarity about how their work actually happens, and want infrastructure that scales without becoming their full-time job.</p>
        <p>Every client system we pitch, we've already run internally. Nothing runs that you can't see and stop — you approve everything.</p>
        <a href="/work/about" class="operator-link">Meet the operator →</a>
      </div>
      <div class="operator-cta">
        <a href="/work/intake" class="btn-plaque">Start your brief</a>
        <p class="operator-note">A 10-minute structured brief that replaces the vague discovery call. No commitment — just clarity.</p>
      </div>
    </div>
  </section>

</GlasshouseLayout>

<style>
  /* ── Hero ── */
  .hero {
    min-height: 88vh;
    min-height: 88svh;
    align-content: center;
    background:
      linear-gradient(180deg, rgba(27, 30, 46, 0.52) 0%, rgba(27, 30, 46, 0.66) 55%, #1B1E2E 100%),
      url('/gh-hero-conservatory.jpg') center / cover no-repeat,
      var(--gh-charcoal);
    color: var(--gh-cream);
    --gh-focus: var(--gh-blue);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.35rem;
    padding: 5rem 0 6rem;
    max-width: 50rem;
    margin-inline: auto;
  }
  .hero-mark {
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.45));
  }
  .hero-eyebrow { color: var(--gh-brass-bright); }
  .hero-headline {
    font-family: var(--gh-serif);
    font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero-offer {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.6;
    color: var(--gh-cream);
    opacity: 0.92;
    max-width: 44ch;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }
  .hero-avail {
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(233, 223, 203, 0.72);
  }

  /* ── Section chrome ── */
  .sec { padding-block: 5rem; }
  .sec-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
    margin-bottom: 3rem;
  }
  .sec-headline {
    font-family: var(--gh-serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    max-width: 26ch;
    text-wrap: balance;
  }
  .sec-headline--display {
    font-family: var(--gh-display);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .sec-rule { width: min(16rem, 60vw); }
  .sec-sub {
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.8;
    max-width: 48ch;
  }

  /* ── Museum plaques ── */
  .plaques {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .plaque {
    background: var(--gh-paper);
    border: 1px solid rgba(27, 30, 46, 0.38);
    box-shadow:
      inset 0 0 0 4px var(--gh-paper),
      inset 0 0 0 5px rgba(27, 30, 46, 0.22);
    clip-path: polygon(
      10px 0, calc(100% - 10px) 0, 100% 10px,
      100% calc(100% - 10px), calc(100% - 10px) 100%,
      10px 100%, 0 calc(100% - 10px), 0 10px
    );
    padding: 2rem 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .plaque-roundel { margin-bottom: 0.25rem; }
  .plaque h3 {
    font-family: var(--gh-serif);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .plaque p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--gh-ink-soft);
    flex: 1;
  }
  .plaque-tag {
    align-self: flex-start;
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #3B2E17;
    background: linear-gradient(180deg, var(--gh-brass-bright), var(--gh-brass));
    border: 1px solid var(--gh-brass-edge);
    padding: 0.4em 0.9em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  /* ── Specimen plates ── */
  .plates {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .plate {
    background: var(--gh-charcoal-lift);
    border: 2px solid var(--gh-brass);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 4px 20px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
  }
  .plate-texture {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--gh-brass-edge);
  }
  .plate-texture--walnut {
    background-image:
      linear-gradient(160deg, rgba(27, 30, 46, 0.22), rgba(27, 30, 46, 0.5)),
      url('/swatch-warm-walnut.png');
  }
  .plate-texture--iron {
    background-image:
      linear-gradient(160deg, rgba(27, 30, 46, 0.55), rgba(44, 90, 86, 0.5)),
      url('/swatch-brushed-silver.png');
  }
  .plate-texture--glass {
    background-image:
      linear-gradient(160deg, rgba(142, 203, 209, 0.28), rgba(27, 30, 46, 0.4)),
      url('/swatch-frosted-glass.png');
  }
  .plate-texture--green {
    background-image:
      linear-gradient(160deg, rgba(27, 30, 46, 0.28), rgba(27, 30, 46, 0.55)),
      url('/swatch-living-botanicals.png');
  }
  .plate-name {
    padding: 1.15rem 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid rgba(176, 141, 87, 0.5);
  }
  .plate-stage {
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gh-brass-bright);
  }
  .plate-material {
    font-family: var(--gh-display);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gh-blue);
  }
  .plate-name p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--gh-cream-soft);
  }

  /* ── Proof ledger ── */
  .proof-ledger {
    list-style: none;
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }
  .proof-ledger li {
    position: relative;
    padding-left: 1.75rem;
    font-size: 1.02rem;
    line-height: 1.65;
  }
  .proof-ledger li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gh-brass);
    background: rgba(176, 141, 87, 0.25);
    transform: rotate(45deg);
  }
  .proof-note {
    text-align: center;
    font-style: italic;
    color: var(--gh-teal-ink);
    margin-top: 2.5rem;
    font-size: 1rem;
  }

  /* ── Operator + close ── */
  .sec--operator { padding-block: 0 5.5rem; }
  .operator-rule {
    width: min(28rem, 80vw);
    margin: 0 auto 4rem;
  }
  .operator-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 58rem;
    margin-inline: auto;
  }
  .operator-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .operator-copy .sec-headline { max-width: none; }
  .operator-copy p {
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--gh-ink-soft);
    max-width: 54ch;
  }
  .operator-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--gh-teal-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(44, 90, 86, 0.4);
    align-self: flex-start;
    padding-bottom: 0.1rem;
  }
  .operator-link:hover { border-bottom-color: var(--gh-teal-ink); }
  .operator-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .operator-note {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--gh-ink-soft);
    max-width: 26ch;
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    .plates { grid-template-columns: repeat(2, 1fr); }
    .operator-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .operator-cta { align-items: stretch; }
    .operator-cta .btn-plaque { text-align: center; }
  }
  @media (max-width: 680px) {
    .hero-inner { padding: 4rem 0 5rem; }
    .sec { padding-block: 3.5rem; }
    .sec-head { margin-bottom: 2.25rem; }
    .plaques { grid-template-columns: 1fr; }
    .plaque { padding: 1.6rem 1.4rem 1.5rem; }
    .plates { grid-template-columns: 1fr; }
    .plate-texture { aspect-ratio: 5 / 2; }
    .proof-ledger li { font-size: 0.97rem; }
  }
</style>
