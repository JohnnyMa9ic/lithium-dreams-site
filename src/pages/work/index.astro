---
import GlasshouseLayout from '../../components/GlasshouseLayout.astro';
---

<GlasshouseLayout activePage="/work">

  <!-- Hero — the conservatory at dusk, composed left -->
  <section class="stratum hero">
    <div class="hero-inner">
      <img src="/gh-medallion-256.png" alt="" width="56" height="56" class="hero-mark" fetchpriority="high" />
      <p class="gh-eyebrow hero-eyebrow">Glasshouse Systems Studio</p>
      <h1 class="hero-headline">You run the business. The&nbsp;systems should run themselves.</h1>
      <p class="hero-offer">Systems and automation for people who'd rather run their business than wrestle their tools.</p>
      <div class="hero-actions">
        <a href="/work/intake" class="btn-plaque">Start your brief</a>
        <a href="#method" class="btn-ghost">See how we work</a>
      </div>
      <p class="hero-avail">Taking new projects — fall 2026.</p>
    </div>
  </section>

  <!-- Commissioned works — the problems, as a full-width ledger -->
  <section class="stratum stratum--cream sec" id="commissions" aria-labelledby="commissions-h">
    <header class="sec-head">
      <p class="gh-eyebrow">Commissioned Works</p>
      <h2 class="sec-headline" id="commissions-h">The problems we take off your&nbsp;plate.</h2>
    </header>
    <div class="ledger">
      <article class="ledger-row">
        <div class="ledger-num" aria-hidden="true">01</div>
        <h3 class="ledger-title">Leads slip through the cracks.</h3>
        <div class="ledger-body">
          <p>Lead capture, response workflows, qualification, scheduling, and follow-up. AI where it earns its place — not everywhere.</p>
          <p class="ledger-nouns">Forms &amp; approvals · CRM &amp; operations · email &amp; scheduling · integrations</p>
          <div class="ledger-tag">Automation Systems</div>
        </div>
      </article>
      <article class="ledger-row">
        <div class="ledger-num" aria-hidden="true">02</div>
        <h3 class="ledger-title">You're the bottleneck for everything.</h3>
        <div class="ledger-body">
          <p>Inbox, calendar, meeting prep, and metrics for the solo operator. Systems built around how you actually work.</p>
          <p class="ledger-nouns">Dashboards · reporting · alerts &amp; metrics · mission control</p>
          <div class="ledger-tag">Operator Dashboards</div>
        </div>
      </article>
      <article class="ledger-row">
        <div class="ledger-num" aria-hidden="true">03</div>
        <h3 class="ledger-title">You can never find what you already know.</h3>
        <div class="ledger-body">
          <p>Ongoing monitoring, synthesis, and brief generation. Everything your business knows, organized so you can actually find it.</p>
          <p class="ledger-nouns">Second brain · documentation · institutional memory · AI search</p>
          <div class="ledger-tag">Knowledge Systems</div>
        </div>
      </article>
      <article class="ledger-row">
        <div class="ledger-num" aria-hidden="true">04</div>
        <h3 class="ledger-title">Publishing eats your week.</h3>
        <div class="ledger-body">
          <p>One pipeline from idea to published — and a brand that remembers what it has already made. Less manual assembly, more signal.</p>
          <p class="ledger-nouns">Content operations · brand memory · creative archives · repurposing</p>
          <div class="ledger-tag">Creative Systems</div>
        </div>
      </article>
    </div>
  </section>

  <!-- The method — four stages -->
  <section class="stratum stratum--dark sec" id="method" aria-labelledby="method-h">
    <header class="sec-head sec-head--split">
      <div>
        <p class="gh-eyebrow">The Method</p>
        <h2 class="sec-headline sec-headline--display" id="method-h">Four stages. No&nbsp;shortcuts.</h2>
      </div>
      <p class="sec-sub">The same four stages, every engagement — understand first, automate last.</p>
    </header>
    <div class="plates">
      <figure class="plate">
        <div class="plate-texture plate-texture--walnut" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">01 · Understand</div>
          <p>Every business already has an operating system. It lives in spreadsheets, in one person's head, or as habit. We map how your work actually flows before touching any tools.</p>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="plate-texture plate-texture--iron" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">02 · Design</div>
          <p>We improve it, document it, and map the gaps. Structure before tools. Clarity before complexity. The design phase is where most of the value lives.</p>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="plate-texture plate-texture--glass" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">03 · Build</div>
          <p>Then we build the infrastructure that lets it scale — and you can see through all of it. Dashboards, outputs, and documentation that show exactly what's working.</p>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="plate-texture plate-texture--green" role="presentation"></div>
        <figcaption class="plate-name">
          <div class="plate-stage">04 · Operate</div>
          <p>Clean handoff with full documentation, then ongoing support. Systems only work if people use them. We stay until it runs without us — and check in to make sure it still does.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Proof — the studio runs on its own systems -->
  <section class="stratum stratum--cream sec" id="proof" aria-labelledby="proof-h">
    <div class="proof-grid">
      <header class="proof-head">
        <p class="gh-eyebrow">Proof</p>
        <h2 class="sec-headline" id="proof-h">Every system we sell, we run&nbsp;first.</h2>
        <p class="proof-note">If a system doesn't survive contact with real operations, we don't sell it.</p>
      </header>
      <ul class="proof-ledger">
        <li>The research and monitoring stack that briefs the studio every morning — the same knowledge systems we build for clients.</li>
        <li>The content pipeline behind the studio's own channel and this site — the creative systems track, running in production.</li>
        <li>The project brief on this site fed our first client engagement end to end — a structured brief in, a finished proposal out, for a real-estate office in eastern Iowa.</li>
      </ul>
    </div>
  </section>

  <!-- The operator + close -->
  <section class="stratum stratum--cream sec sec--operator" id="operator" aria-labelledby="operator-h">
    <div class="gh-rule operator-rule" aria-hidden="true"><span></span></div>
    <div class="operator-grid">
      <div class="operator-copy">
        <p class="gh-eyebrow">The Operator</p>
        <h2 class="sec-headline" id="operator-h">Built by an operator, not an AI&nbsp;tourist.</h2>
        <p>Glasshouse Systems Studio is a systems design practice. AI is one of our tools — not our product and not our identity. Technology is just the tool; clarity is the product. We design practical operational systems for people who need to see how their work actually happens, and want infrastructure that scales without becoming their full-time job.</p>
        <p>Every client system we pitch, we've already run internally. Nothing runs that you can't see and stop — you approve everything.</p>
        <a href="/work/about" class="operator-link">Meet the operator →</a>
      </div>
      <div class="operator-cta">
        <p class="operator-invite">Every engagement starts with a conversation. Tell us about your mission, and we'll recommend the right first&nbsp;step.</p>
        <a href="/work/intake" class="btn-plaque">Start your brief</a>
        <p class="operator-note">A 10-minute structured brief that replaces the vague discovery call. No commitment — just clarity.</p>
      </div>
    </div>
  </section>

</GlasshouseLayout>

<style>
  /* ── Hero ── */
  .hero {
    align-content: center;
    background:
      linear-gradient(105deg, rgba(27, 30, 46, 0.85) 0%, rgba(27, 30, 46, 0.52) 48%, rgba(27, 30, 46, 0.18) 100%),
      linear-gradient(180deg, rgba(27, 30, 46, 0.3) 0%, rgba(27, 30, 46, 0.12) 60%, #1B1E2E 100%),
      url('/footer-conservatory.jpg') 62% center / cover no-repeat,
      var(--gh-charcoal);
    color: var(--gh-cream);
    --gh-focus: var(--gh-glass);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
    padding: clamp(3.5rem, 8vh, 5.5rem) 0;
    max-width: 62rem;
  }
  .hero-mark {
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.45));
    margin-bottom: 0.25rem;
  }
  .hero-eyebrow { color: var(--gh-brass-bright); }
  .hero-headline {
    font-family: var(--gh-serif);
    font-weight: 600;
    font-size: clamp(2.5rem, 4.8vw, 4.6rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
    text-wrap: balance;
  }
  .hero-offer {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.6;
    color: var(--gh-cream);
    opacity: 0.92;
    max-width: 46ch;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
  }
  .hero-avail {
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(233, 223, 203, 0.72);
    border-top: 1px solid var(--gh-hairline-light);
    padding-top: 1.1rem;
    margin-top: 1.4rem;
  }

  /* ── Section chrome — editorial, left-composed ── */
  .sec { padding-block: var(--gh-sec-pad); }
  .sec-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-bottom: clamp(2rem, 4vh, 3rem);
  }
  .sec-head--split {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .sec-head--split > div {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .sec-headline {
    font-family: var(--gh-serif);
    font-weight: 600;
    font-size: clamp(2rem, 3.4vw, 3.3rem);
    line-height: 1.12;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }
  .sec-headline--display {
    font-family: var(--gh-display);
    font-weight: 600;
    letter-spacing: 0.03em;
    font-size: clamp(1.8rem, 2.9vw, 2.8rem);
    max-width: 22ch;
  }
  .sec-sub {
    font-size: 1rem;
    font-style: italic;
    opacity: 0.8;
    max-width: 34ch;
    padding-bottom: 0.4rem;
  }

  /* ── The ledger — four problems, full width ── */
  .ledger {
    border-top: 1px solid var(--gh-hairline-dark);
  }
  .ledger-row {
    display: grid;
    grid-template-columns: minmax(3.5rem, 0.4fr) 1.4fr 1.6fr;
    gap: clamp(1.25rem, 3vw, 4rem);
    align-items: start;
    padding-block: clamp(1.5rem, 2.8vh, 2.25rem);
    border-bottom: 1px solid var(--gh-hairline-dark);
  }
  .ledger-num {
    font-family: var(--gh-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.4vw, 2.5rem);
    line-height: 1;
    color: var(--gh-brass);
    padding-top: 0.2rem;
  }
  .ledger-title {
    font-family: var(--gh-serif);
    font-weight: 600;
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -0.005em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .ledger-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .ledger-body p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--gh-ink-soft);
    max-width: 58ch;
  }
  .ledger-body .ledger-nouns {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gh-ink-soft);
    line-height: 1.9;
    max-width: none;
    margin-top: -0.25rem;
  }
  .ledger-tag {
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #3B2E17;
    background: linear-gradient(180deg, var(--gh-brass-bright), var(--gh-brass));
    border: 1px solid var(--gh-brass-edge);
    padding: 0.4em 0.9em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  /* ── Specimen plates ── */
  .plates {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.25rem, 2vw, 2rem);
  }
  .plate {
    background: var(--gh-charcoal-lift);
    border: 1px solid var(--gh-brass);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 4px 20px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
  }
  .plate-texture {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--gh-brass-edge);
  }
  .plate-texture--walnut {
    background-image:
      linear-gradient(160deg, rgba(27, 30, 46, 0.22), rgba(27, 30, 46, 0.5)),
      url('/swatch-warm-walnut.png');
  }
  .plate-texture--iron {
    background-image:
      linear-gradient(160deg, rgba(27, 30, 46, 0.55), rgba(44, 90, 86, 0.5)),
      url('/swatch-brushed-silver.png');
  }
  .plate-texture--glass {
    background-image:
      linear-gradient(160deg, rgba(142, 203, 209, 0.28), rgba(27, 30, 46, 0.4)),
      url('/swatch-frosted-glass.png');
  }
  .plate-texture--green {
    background-image:
      linear-gradient(160deg, rgba(27, 30, 46, 0.28), rgba(27, 30, 46, 0.55)),
      url('/swatch-living-botanicals.png');
  }
  .plate-name {
    padding: 1.25rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-top: 1px solid rgba(176, 141, 87, 0.5);
    flex: 1;
  }
  .plate-stage {
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.88rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gh-brass-bright);
  }
  .plate-material {
    font-family: var(--gh-display);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gh-glass);
  }
  .plate-name p {
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--gh-cream-soft);
  }

  /* ── Proof — statement left, ledger right ── */
  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: start;
  }
  .proof-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .proof-note {
    font-style: italic;
    color: var(--gh-teal-ink);
    font-size: 1.02rem;
    margin-top: 1rem;
    text-wrap: pretty;
  }
  .proof-ledger {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .proof-ledger li {
    position: relative;
    padding: 1.5rem 0 1.5rem 2rem;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.65;
    border-top: 1px solid var(--gh-hairline-dark);
  }
  .proof-ledger li:last-child { border-bottom: 1px solid var(--gh-hairline-dark); }
  .proof-ledger li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 2.15rem;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gh-brass);
    background: rgba(176, 141, 87, 0.25);
    transform: rotate(45deg);
  }

  /* ── Operator + close ── */
  .sec--operator { padding-block: 0 var(--gh-sec-pad); }
  .operator-rule {
    margin: 0 0 clamp(1.75rem, 3.5vh, 2.5rem);
  }
  .operator-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }
  .operator-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .operator-copy p {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--gh-ink-soft);
    max-width: 58ch;
  }
  .operator-link {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--gh-teal-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(44, 90, 86, 0.4);
    padding-bottom: 0.1rem;
  }
  .operator-link:hover { border-bottom-color: var(--gh-teal-ink); }
  .operator-cta {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: center;
    text-align: center;
    background: var(--gh-paper);
    border: 1px solid var(--gh-hairline-dark);
    border-top: 3px solid var(--gh-brass);
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }
  .operator-invite {
    font-family: var(--gh-serif);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.55;
    text-wrap: balance;
  }
  .operator-note {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gh-ink-soft);
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    .ledger-row {
      grid-template-columns: minmax(2.75rem, auto) 1fr;
      grid-template-rows: auto auto;
    }
    .ledger-title { grid-column: 2; }
    .ledger-body { grid-column: 2; }
    .plates { grid-template-columns: repeat(2, 1fr); }
    .proof-grid { grid-template-columns: 1fr; gap: 2rem; }
    .operator-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    /* full-width plaque: center the engraving instead of left-hugging the 30ch caps */
    .operator-cta { align-items: stretch; text-align: center; }
    .operator-cta .btn-plaque { text-align: center; }
    .operator-invite,
    .operator-note { max-width: 46ch; margin-inline: auto; }
  }
  @media (max-width: 680px) {
    .hero-inner { padding: 3.5rem 0 4rem; }
    .sec-head--split { flex-direction: column; align-items: flex-start; }
    .ledger-row { grid-template-columns: 1fr; gap: 0.75rem; }
    .ledger-num { padding-top: 0; }
    .ledger-title { grid-column: 1; max-width: none; }
    .ledger-body { grid-column: 1; }
    .plates { grid-template-columns: 1fr; }
    .plate-texture { aspect-ratio: 5 / 2; }
  }
</style>
