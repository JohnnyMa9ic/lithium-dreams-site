---
import { env } from 'cloudflare:workers';

export const prerender = false;

/* John's private, read-only window into Tyler's Isaac grind. Not linked from
 * anywhere; reached only with the unguessable ?k= key below (an obscurity gate,
 * appropriate for non-sensitive game-completion data). Reads the KV copy that
 * the companion app mirrors, and renders the summary it pushes alongside the
 * raw save — no game data or planner math is duplicated here. */

const VIEW_KEY = 'e17aaaa1c7e881d290277295';
if (Astro.url.searchParams.get('k') !== VIEW_KEY) {
  return new Response('Not found', { status: 404 });
}

const HARD_TOTAL = 408; // Death Certificate
const REGULAR_HARD = 204; // Mega Mush
const CHARS = 34;

type Summary = {
  hard: number;
  normal: number;
  todo: number;
  pct: number;
  megaMush: number;
  sealed: number;
  charsLeft: number;
  stamped: number;
  runLen: number;
  closest: { name: string; tainted: boolean; hard: number; remaining: number }[];
};
type Envelope = {
  save?: { marks?: Record<string, number[]> };
  summary?: Summary | null;
  savedAt?: number;
  device?: string | null;
  serverAt?: string | null;
};

const kv = (env as unknown as { ISAAC_SAVES?: KVNamespace }).ISAAC_SAVES;
let envelope: Envelope | null = null;
if (kv) {
  const raw = await kv.get('save:tyler');
  if (raw) {
    try {
      envelope = JSON.parse(raw) as Envelope;
    } catch {
      envelope = null;
    }
  }
}

function hardFromSave(save: Envelope['save']): number {
  let h = 0;
  for (const row of Object.values(save?.marks ?? {})) {
    for (const v of row) if (v === 2) h++;
  }
  return h;
}

function ago(iso: string | null | undefined): string {
  if (!iso) return 'unknown';
  const then = Date.parse(iso);
  if (Number.isNaN(then)) return 'unknown';
  const s = Math.max(0, Math.floor((Date.now() - then) / 1000));
  if (s < 60) return 'just now';
  const m = Math.floor(s / 60);
  if (m < 60) return `${m} min ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h} hr${h > 1 ? 's' : ''} ago`;
  const d = Math.floor(h / 24);
  return `${d} day${d > 1 ? 's' : ''} ago`;
}

const has = envelope != null && envelope.save != null;
const sum = envelope?.summary ?? null;
const hard = sum?.hard ?? (has ? hardFromSave(envelope!.save) : 0);
const normal = sum?.normal ?? 0;
const todo = sum?.todo ?? HARD_TOTAL - hard - normal;
const pct = sum?.pct ?? Math.round((hard / HARD_TOTAL) * 100);
const megaMush = sum?.megaMush ?? 0;
const sealed = sum?.sealed ?? 0;
const stamped = sum?.stamped ?? 0;
const closest = sum?.closest ?? [];
const syncedAgo = ago(envelope?.serverAt);
const hardW = Math.round((hard / HARD_TOTAL) * 1000) / 10;
const normalW = Math.round((normal / HARD_TOTAL) * 1000) / 10;
const megaW = Math.min(100, Math.round((megaMush / REGULAR_HARD) * 1000) / 10);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tyler's Grind</title>
    <style>
      :root {
        --bg: #0b0806;
        --panel: #171009;
        --panel2: #1e150c;
        --line: #3a2a18;
        --amber: #f6a93f;
        --amber-deep: #a95c12;
        --blood: #c33a2a;
        --cream: #e9decd;
        --dim: #9b8a74;
        --faint: #6d5f4f;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background:
          radial-gradient(120% 60% at 50% -10%, #1a1109 0%, var(--bg) 60%),
          var(--bg);
        color: var(--cream);
        font-family: Georgia, 'Times New Roman', serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }
      .wrap { max-width: 540px; margin: 0 auto; padding: 26px 18px 60px; }
      .eyebrow {
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        letter-spacing: 3px;
        font-size: 11px;
        text-transform: uppercase;
        color: var(--faint);
      }
      h1 {
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        font-weight: 800;
        letter-spacing: 1px;
        font-size: 26px;
        margin: 4px 0 2px;
        color: var(--cream);
      }
      .sub { color: var(--dim); font-size: 13px; margin-bottom: 22px; }
      .card {
        background: linear-gradient(180deg, var(--panel2), var(--panel));
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 20px 18px;
        margin-bottom: 16px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
      }
      .hero { text-align: center; }
      .pct {
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        font-weight: 800;
        font-size: 68px;
        line-height: 1;
        color: var(--amber);
        text-shadow: 0 0 24px rgba(246, 169, 63, 0.25);
      }
      .pct small { font-size: 30px; color: var(--amber-deep); }
      .heroline { color: var(--dim); font-size: 14px; margin-top: 6px; }
      .heroline b { color: var(--cream); font-variant-numeric: tabular-nums; }
      .bar {
        height: 16px;
        border-radius: 9px;
        background: #0a0704;
        border: 1px solid var(--line);
        overflow: hidden;
        display: flex;
        margin: 18px 0 10px;
      }
      .bar .hardseg { background: linear-gradient(180deg, #f6b955, var(--blood)); }
      .bar .normseg { background: linear-gradient(180deg, #6b5836, var(--amber-deep)); }
      .tiers {
        display: flex;
        justify-content: space-between;
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        font-size: 11px;
        letter-spacing: 1.5px;
        color: var(--dim);
      }
      .tiers b { color: var(--cream); }
      .miles { display: flex; gap: 12px; }
      .miles .card { flex: 1; margin: 0; text-align: center; padding: 16px 10px; }
      .mnum {
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        font-weight: 800;
        font-size: 22px;
        color: var(--cream);
        font-variant-numeric: tabular-nums;
      }
      .mnum.done { color: var(--amber); }
      .mlabel {
        font-size: 10.5px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--faint);
        margin-top: 4px;
        font-family: 'Trebuchet MS', system-ui, sans-serif;
      }
      .sectitle {
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        letter-spacing: 2px;
        font-size: 12px;
        text-transform: uppercase;
        color: var(--amber);
        margin: 4px 0 14px;
      }
      .crow {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 0;
        border-top: 1px solid rgba(58, 42, 24, 0.5);
      }
      .crow:first-of-type { border-top: none; }
      .cname { flex: 1; font-size: 14px; color: var(--cream); }
      .cname .t { color: var(--blood); font-size: 11px; letter-spacing: 1px; }
      .cbar {
        width: 84px;
        height: 8px;
        border-radius: 5px;
        background: #0a0704;
        border: 1px solid var(--line);
        overflow: hidden;
      }
      .cbar span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--amber-deep), var(--amber));
      }
      .cnum {
        width: 62px;
        text-align: right;
        font-family: 'Trebuchet MS', system-ui, sans-serif;
        font-size: 12px;
        color: var(--dim);
        font-variant-numeric: tabular-nums;
      }
      .cnum b { color: var(--cream); }
      .foot {
        text-align: center;
        color: var(--faint);
        font-size: 12px;
        margin-top: 22px;
        line-height: 1.6;
      }
      .foot .dot { color: var(--amber-deep); }
      .empty { text-align: center; color: var(--dim); padding: 30px 10px; }
      .empty .big { font-size: 40px; margin-bottom: 10px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="eyebrow">Midnight Visitor Logs · private</div>
      <h1>Tyler's Grind</h1>
      <div class="sub">The Road to Dead God — synced from his companion app.</div>

      {!has ? (
        <div class="card empty">
          <div class="big">🎮</div>
          <div>No save synced yet.</div>
          <div style="margin-top:8px;font-size:13px;color:var(--faint)">
            Once Tyler stamps a mark in the app, his progress shows up here on its own.
          </div>
        </div>
      ) : (
        <>
          <div class="card hero">
            <div class="pct">{pct}<small>%</small></div>
            <div class="heroline">
              <b>{hard}</b> / {HARD_TOTAL} marks on hard
            </div>
            <div class="bar" aria-hidden="true">
              <span class="hardseg" style={`width:${hardW}%`}></span>
              <span class="normseg" style={`width:${normalW}%`}></span>
            </div>
            <div class="tiers">
              <span><b>{todo}</b> TODO</span>
              <span><b>{normal}</b> NORMAL</span>
              <span><b>{hard}</b> HARD</span>
            </div>
          </div>

          <div class="miles">
            <div class="card">
              <div class={megaMush >= REGULAR_HARD ? 'mnum done' : 'mnum'}>
                {megaMush >= REGULAR_HARD ? '✦ ' : ''}{megaMush}/{REGULAR_HARD}
              </div>
              <div class="mlabel">Mega Mush</div>
              <div class="bar" style="margin:12px 0 0" aria-hidden="true">
                <span class="hardseg" style={`width:${megaW}%`}></span>
              </div>
            </div>
            <div class="card">
              <div class={sealed >= CHARS ? 'mnum done' : 'mnum'}>{sealed}/{CHARS}</div>
              <div class="mlabel">Characters sealed</div>
              <div style="margin-top:12px;font-size:11px;color:var(--faint)">
                {stamped} marks stamped in all
              </div>
            </div>
          </div>

          {closest.length > 0 && (
            <div class="card">
              <div class="sectitle">Closest to sealed</div>
              {closest.map((c) => (
                <div class="crow">
                  <div class="cname">
                    {c.name}
                    {c.tainted && <span class="t"> · T</span>}
                  </div>
                  <div class="cbar" aria-hidden="true">
                    <span style={`width:${Math.round((c.hard / 12) * 100)}%`}></span>
                  </div>
                  <div class="cnum"><b>{c.hard}</b>/12 · {c.remaining} left</div>
                </div>
              ))}
            </div>
          )}
        </>
      )}

      <div class="foot">
        {has && (
          <span>
            last synced <b>{syncedAgo}</b> <span class="dot">·</span>{' '}
          </span>
        )}
        408 hard = Death Certificate <span class="dot">·</span> Dead God also needs every item
      </div>
    </div>
  </body>
</html>
