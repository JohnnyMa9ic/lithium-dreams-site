---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activePage?: string;
}

const {
  title = 'Glasshouse Systems Studio — Systems & Automation for Small Business',
  description = "Systems and automation for people who'd rather run their business than wrestle their tools. Glasshouse Systems Studio, Iowa.",
  ogImage = '/footer-conservatory.jpg',
  activePage = '',
} = Astro.props;

const siteURL = 'https://lithium-dreams.com';
const canonicalURL = new URL(Astro.url.pathname, siteURL);

const navLinks = [
  { href: '/work', label: 'Overview' },
  { href: '/work/intake', label: 'Start a Project' },
  { href: '/work/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="icon" href="/gh-medallion-64.png" type="image/png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:site_name" content="Glasshouse Systems Studio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Glasshouse Systems Studio",
      "url": `${siteURL}/work`,
      "logo": `${siteURL}/gh-medallion-256.png`,
      "description": "Systems and automation design studio for small and medium businesses. Research, workflow automation, dashboards, and knowledge systems.",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Lithium Dreams Industries",
        "url": siteURL,
      },
      "areaServed": "United States",
    })} />
  </head>
  <body class="gh-body">
    <a href="#gh-main" class="gh-skip">Skip to content</a>

    <nav class="gh-nav" aria-label="Glasshouse Systems Studio">
      <div class="gh-nav-inner">
        <a href="/work" class="gh-logo">
          <img src="/gh-medallion-64.png" alt="" width="30" height="30" class="gh-logo-mark" />
          <span class="gh-wordmark">Glasshouse <span class="gh-wordmark-sub">Systems Studio</span></span>
        </a>
        <div class="gh-nav-links">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={activePage === link.href ? 'active' : ''}
              aria-current={activePage === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <main id="gh-main" class="gh-content">
      <slot />
    </main>

    <footer class="gh-footer stratum stratum--dark">
      <div class="gh-footer-inner">
        <a href="/work" class="gh-footer-brand" aria-label="Glasshouse Systems Studio">
          <img
            src="/card/brand-lockup.webp"
            alt="Glasshouse Systems Studio — Think, Design, Build, Observe, Grow"
            class="gh-footer-lockup"
            width="180"
            loading="lazy"
            decoding="async"
          />
        </a>
        <nav class="gh-footer-links" aria-label="Studio links">
          <a href="/work/about">About the studio</a>
          <a href="/work/intake">Start a project</a>
          <a href="/card/">The card</a>
        </nav>
        <p class="gh-footer-parent">A Lithium Dreams studio · Iowa</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Glasshouse v3 brand tokens */
    --gh-teal: #3F7F7A;
    --gh-teal-ink: #2C5A56;      /* derived: small text / links on cream */
    --gh-brass: #B08D57;
    --gh-brass-bright: #C9A468;  /* derived: plaque gradient top */
    --gh-brass-edge: #8A6C3F;    /* derived: plaque bevel edge */
    --gh-glass: #8ECBD1;         /* stained glass — light on dark only */
    --gh-cream: #E9DFCB;
    --gh-paper: #F2EBDB;         /* derived: raised paper panels on cream */
    --gh-charcoal: #1B1E2E;
    --gh-charcoal-lift: #232738; /* derived: raised panels on charcoal */
    --gh-ink: #1B1E2E;
    --gh-ink-soft: rgba(27, 30, 46, 0.74);
    --gh-cream-soft: rgba(233, 223, 203, 0.82);
    --gh-hairline-dark: rgba(27, 30, 46, 0.28);
    --gh-hairline-light: rgba(233, 223, 203, 0.28);
    --gh-max: 96rem;
    --gh-gutter: clamp(1.25rem, 4vw, 4.5rem);
    --gh-sec-pad: clamp(3rem, 6.5vh, 4.75rem);
    --gh-display: 'Cinzel', 'Trajan Pro', serif;
    --gh-serif: 'Source Serif 4', 'Source Serif Pro', Georgia, serif;
    --gh-mono: ui-monospace, 'SFMono-Regular', Consolas, monospace;
    --gh-focus: var(--gh-teal-ink);

    /* Legacy aliases — /work/intake and other un-reskinned pages consume these.
       Do not remove until every page under GlasshouseLayout is on the v3 names. */
    --gh-text: var(--gh-ink);
    --gh-muted: rgba(27, 30, 46, 0.62);
    --gh-silver: rgba(27, 30, 46, 0.3);
    --gh-blue: var(--gh-teal-ink);
    --gh-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }
  [id] { scroll-margin-top: 5rem; }

  .gh-body {
    background: var(--gh-cream);
    color: var(--gh-ink);
    font-family: var(--gh-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .gh-content { flex: 1; width: 100%; }

  /* ── Strata: full-bleed bands, wide aligned content column ── */
  .stratum {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gh-gutter), 1fr)
      [content-start] minmax(0, var(--gh-max))
      [content-end] minmax(var(--gh-gutter), 1fr)
      [full-end];
  }
  .stratum > * { grid-column: content; }
  .stratum > .full-bleed { grid-column: full; }

  .stratum--cream { background: var(--gh-cream); }
  .stratum--dark {
    background: var(--gh-charcoal);
    color: var(--gh-cream);
    --gh-focus: var(--gh-glass);
  }

  /* Boxed utility for legacy pages that expect the old contained frame */
  .gh-boxed {
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1.25rem;
    width: 100%;
  }

  /* ── Shared brand furniture ── */
  .gh-eyebrow {
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gh-teal-ink);
  }
  .stratum--dark .gh-eyebrow { color: var(--gh-brass); }

  .gh-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--gh-brass);
  }
  .gh-rule::before,
  .gh-rule::after {
    content: '';
    height: 1px;
    flex: 1;
    background: currentColor;
    opacity: 0.55;
  }
  .gh-rule span {
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .btn-plaque {
    display: inline-block;
    padding: 0.95rem 2.1rem;
    background: linear-gradient(180deg, var(--gh-brass-bright), var(--gh-brass));
    color: var(--gh-charcoal);
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--gh-brass-edge);
    border-radius: 2px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 2px 10px rgba(0, 0, 0, 0.22);
    transition: filter 0.15s ease;
  }
  .btn-plaque:hover { filter: brightness(1.07); }

  .btn-ghost {
    display: inline-block;
    padding: 0.95rem 2.1rem;
    background: transparent;
    color: var(--gh-cream);
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--gh-cream-soft);
    border-radius: 2px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-ghost:hover {
    background: rgba(233, 223, 203, 0.12);
    border-color: var(--gh-cream);
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--gh-focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .gh-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    background: var(--gh-charcoal);
    color: var(--gh-cream);
    padding: 0.75rem 1.25rem;
    font-family: var(--gh-serif);
    text-decoration: none;
  }
  .gh-skip:focus-visible { left: 0; }

  /* ── Nav — aligned to the same content grid as the page ── */
  .gh-nav {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gh-gutter), 1fr)
      [content-start] minmax(0, var(--gh-max))
      [content-end] minmax(var(--gh-gutter), 1fr)
      [full-end];
    background: rgba(27, 30, 46, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(176, 141, 87, 0.4);
    position: sticky;
    top: 0;
    z-index: 100;
    --gh-focus: var(--gh-glass);
  }
  .gh-nav-inner {
    grid-column: content;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 0;
  }

  .gh-logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    padding: 0.25rem 0;
  }
  .gh-logo-mark { display: block; }
  .gh-wordmark {
    font-family: var(--gh-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gh-cream);
    white-space: nowrap;
  }
  .gh-wordmark-sub {
    font-weight: 400;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: var(--gh-cream-soft);
  }

  .gh-nav-links {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .gh-nav-links a {
    font-family: var(--gh-serif);
    font-size: 0.875rem;
    color: var(--gh-cream-soft);
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease;
  }
  .gh-nav-links a:hover { color: var(--gh-cream); }
  .gh-nav-links a.active {
    color: var(--gh-glass);
    border-bottom-color: var(--gh-glass);
  }

  /* ── Footer — brand left, wayfinding right, one quiet door ── */
  .gh-footer {
    border-top: 4px solid var(--gh-brass);
    background:
      linear-gradient(180deg, rgba(27, 30, 46, 0.88) 0%, rgba(27, 30, 46, 0.95) 100%),
      url('/gh-footer-conservatory.jpg') center / cover no-repeat,
      var(--gh-charcoal);
  }
  .gh-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    padding: 1.5rem 0;
  }
  .gh-footer-brand { display: block; line-height: 0; }
  .gh-footer-lockup {
    width: min(180px, 48vw);
    height: auto;
  }
  .gh-footer-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .gh-footer-links a {
    font-size: 0.95rem;
    color: var(--gh-cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(233, 223, 203, 0.35);
    padding-bottom: 0.2rem;
    transition: border-color 0.15s ease;
  }
  .gh-footer-links a:hover { border-bottom-color: var(--gh-glass); }
  .gh-footer-parent {
    font-size: 0.8rem;
    color: var(--gh-cream-soft);
  }

  @media (max-width: 768px) {
    .gh-nav-inner { flex-wrap: wrap; gap: 0.4rem 1rem; }
    .gh-nav-links { margin-left: 0; width: 100%; justify-content: flex-start; gap: 0.25rem; }
    .gh-nav-links a { padding: 0.6rem 0.6rem; }
    .gh-wordmark-sub { display: none; }
    .gh-footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem 0 1.75rem;
    }
  }
</style>
