{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-04",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "lithium-dreams-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "MISSION_INTAKE",
			"id": "8722efcda2d548fbbce0c267d3b1c629"
		},
		{
			"binding": "ISAAC_SAVES",
			"id": "d3a321ff3eb94db0b2b51fd3657f1b4c"
		}
	],
	"observability": {
		"enabled": true
	}
}
